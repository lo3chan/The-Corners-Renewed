{
  "sea_level": 0,
  "disable_mob_generation": false,
  "aquifers_enabled": false,
  "ore_veins_enabled": true,
  "legacy_random_source": false,
  "default_block": {
    "Name": "minecraft:amethyst_block"
  },
  "default_fluid": {
    "Name": "minecraft:air"
  },
  "noise": {
    "min_y": 0,
    "height": 384,
    "size_horizontal": 1,
    "size_vertical": 2
  },
  "noise_router": {
    "barrier": 0,
    "fluid_level_floodedness": 0,
    "fluid_level_spread": 0,
    "lava": 0,
    "temperature": 0,
    "vegetation": 0,
    "continents": 0,
    "erosion": 0,
    "depth": 0,
    "ridges": 0,
    "initial_density_without_jaggedness": 0,
    "final_density": "crystal_realm:final_density",
    "vein_toggle": 0,
    "vein_ridged": 0,
    "vein_gap": 0
  },
  "spawn_target": [],
  "surface_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:vertical_gradient",
          "random_name": "minecraft:stone_foundation",
          "true_at_and_below": {
            "absolute": 90
          },
          "false_at_and_above": {
            "absolute": 120
          }
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:stone"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:noise_threshold",
          "noise": "minecraft:surface",
          "min_threshold": 0.45,
          "max_threshold": 0.7
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:calcite"
          }
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:noise_threshold",
          "noise": "minecraft:surface_secondary",
          "min_threshold": 0.65,
          "max_threshold": 0.85
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {
            "Name": "minecraft:budding_amethyst"
          }
        }
      },
      {
        "type": "minecraft:block",
        "result_state": {
          "Name": "minecraft:amethyst_block"
        }
      }
    ]
  }
}